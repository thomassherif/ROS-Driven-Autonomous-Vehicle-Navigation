<?xml version="1.0"?>
<launch>

  <!-- Start the AudiBot Robot -->
  <include file="$(find audibot_gazebo)/launch/audibot_robot.launch" >
    <arg name="start_x" value="0" />
    <arg name="start_y" value="0" />
    <arg name="start_z" value="0" />
    <arg name="start_yaw" value="0" />
    <arg name="pub_tf" value="true" />
    <arg name="tf_freq" value="100.0" />
    <arg name="blue" value="false" />
  </include>

  <!-- Launch the Gazebo World -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find autonomous_systems_project_team_3)/Worlds/Racing_Track.world"/>
  </include>

  <!-- Wait for Gazebo and robot to be ready -->
  <param name="use_sim_time" value="true"/>

  <!-- Launch control nodes in order -->

  <node pkg="autonomous_systems_project_team_3" type="speed_control.py" name="speed_control" output="screen" />
  <node pkg="autonomous_systems_project_team_3" type="lateral_control.py" name="lateral_control" output="screen" />
  <node pkg="autonomous_systems_project_team_3" type="position_control.py" name="position_control" output="screen" />
  <node pkg="autonomous_systems_project_team_3" type="kalman_filter.py" name="kalman_filter" output="screen" />
  <node pkg="autonomous_systems_project_team_3" type="planner.py" name="planner" output="screen" />

</launch>
